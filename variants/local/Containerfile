# PyYAML from a local source tree (unmodified 5.3.1 sdist), mounted only during the build
FROM docker.io/library/ubuntu:20.04@sha256:c664f8f86ed5a386b0a340d981b8f81714e21a8b9c73f658c4bea56aa179d54a
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv  \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install -q --no-cache-dir "pip==25.0.1"
ENV PY=/opt/venv/bin/python
RUN --mount=type=bind,source=src/pyyaml-5.3.1,target=/src/pyyaml,rw /opt/venv/bin/pip install --no-cache-dir /src/pyyaml
COPY app/ /app/
CMD ["sh", "-c", "exec $PY /app/app.py"]
